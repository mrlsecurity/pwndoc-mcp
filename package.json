{
  "name": "pwndoc-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for PwnDoc — session, audits, findings, comments, subscriptions",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "pwndoc-mcp": "dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "axios": "1.15.0",
    "socket.io-client": "4.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsx": "4.20.6",
    "typescript": "5.7.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
